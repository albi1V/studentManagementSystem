{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "StudentManagement.Api",
    "Audience": "StudentManagement.Frontend",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Otp": {
    "ExpiryMinutes": 10,
    "ResendCooldownSeconds": 60,
    "MaxVerificationAttempts": 5,
    "MaxResends": 5
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "FromName": "Student Management System",
    "UseSsl": true
  }
}
